# Google Cloud → OAuth 2.0 → Web application client ID (for Google Sign-In)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=""

# Google Cloud → OAuth 2.0 → iOS client ID (same bundle ID as app.json → ios.bundleIdentifier)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=""

# Django API host URL. Docker maps host 8003 → container 8000.
# On Android emulator, localhost is rewritten to 10.0.2.2 automatically.
EXPO_PUBLIC_API_URL="http://localhost:8003"
