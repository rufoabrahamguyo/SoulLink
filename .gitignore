# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

node_modules/

# Frontend (Expo)
frontend/.expo/
frontend/dist/
frontend/web-build/
frontend/expo-env.d.ts
frontend/.kotlin/

# Frontend native (regenerate with npx expo prebuild from frontend/)
frontend/ios
frontend/android

# Metro
frontend/.metro-health-check*

# Dependencies & logs
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Env — never commit secrets
.env
.env.*
!.env.example
!**/.env.example

# TypeScript
*.tsbuildinfo

# Signing / keys
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

.README.md
